{
  "name": "dokanos",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json && vite build",
    "start": "node server.ts",
    "seed": "tsx apps/api/scripts/seed.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/web/dist apps/api/dist packages/shared/dist",
    "lint": "eslint packages/shared/src apps/api/src apps/api/tests apps/api/scripts apps/web/src server.ts",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc --noEmit",
    "test": "vitest run --dir apps/api --config apps/api/vitest.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dokanos/shared": "workspace:*",
    "@google/genai": "^2.32.0",
    "@hookform/resolvers": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.65.0",
    "mongoose": "^9.11.4",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "resend": "^6.36.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
