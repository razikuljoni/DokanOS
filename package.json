{
  "name": "dokanos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "pnpm --filter @dokanos/shared build && pnpm --filter api build && vite build",
    "start": "node server.ts",
    "seed": "pnpm --filter api seed",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/web/dist apps/api/dist packages/shared/dist",
    "lint": "eslint packages/shared/src apps/api/src apps/api/tests apps/api/scripts apps/web/src server.ts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dokanos/shared": "workspace:*",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^4.1.3",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.69.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.8.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.12.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.4.0",
    "recharts": "^2.15.1",
    "resend": "^4.1.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.3",
    "vitest": "^3.0.8"
  }
}
