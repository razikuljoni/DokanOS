PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dokanos?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-random-64-char-secret-for-access-tokens-only
REFRESH_TOKEN_SECRET=replace-with-random-64-char-secret-for-cookie-signing-only
COOKIE_SECRET=replace-with-random-64-char-secret-for-cookie-parser
FRONTEND_URL=http://localhost:5173
UPSTASH_REDIS_URL=redis://localhost:6379
RESEND_API_KEY=re_placeholder_key

# SSLCommerz Sandbox Gate:
# - In development (NODE_ENV=development), POST /api/v1/billing/sslcommerz/init returns the local
#   in-app sandbox simulator modal URL (/app/billing?sandbox_checkout=sslcommerz&tran_id=...).
# - In production (NODE_ENV=production) with SSLCZ_SANDBOX=true, the server calls the live
#   SSLCommerz Sandbox v4 API (https://sandbox.sslcommerz.com/gwprocess/v4/api.php) and returns
#   the hosted GatewayPageURL. Both 'testbox'/'qwerty' and registered developer sandbox credentials work.
SSLCZ_STORE_ID=testbox
SSLCZ_STORE_PASSWD=qwerty
SSLCZ_SANDBOX=true
SSLCZ_SUCCESS_URL=http://localhost:4000/api/v1/billing/sslcommerz/success
SSLCZ_FAIL_URL=http://localhost:4000/api/v1/billing/sslcommerz/fail
SSLCZ_CANCEL_URL=http://localhost:4000/api/v1/billing/sslcommerz/cancel
SSLCZ_IPN_URL=http://localhost:4000/api/v1/billing/sslcommerz/ipn

# Stripe Test Mode (Secondary Gateway):
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
SEED_DEMO=true
