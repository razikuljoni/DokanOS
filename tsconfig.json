{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@dokanos/shared": ["./packages/shared/src/index.ts"]
    },
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "packages/shared/src/**/*",
    "apps/api/src/**/*",
    "apps/api/tests/**/*",
    "apps/web/src/**/*",
    "server.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "src"]
}
